{
  "name": "user-story-generator-agent",
  "version": "1.0.0",
  "description": "Agent responsible for receiving test scenarios and converting them into Agile user stories",
  "main": "api/generate-user-stories.js",
  "type": "module",
  "scripts": {
    "start": "vercel dev --listen 3001",
    "dev": "vercel dev --listen 3001",
    "commit": "cz",
    "example:github": "node examples/github-integration-example.js",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\"",
    "lint": "eslint src/ api/ tests/",
    "lint:fix": "eslint src/ api/ tests/ --fix",
    "prepare": "husky",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:patch": "standard-version --release-as patch",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AuronForge/user-story-generator-agent.git"
  },
  "keywords": [
    "ai",
    "agent",
    "user-stories",
    "agile",
    "test-scenarios"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AuronForge/user-story-generator-agent/issues"
  },
  "homepage": "https://github.com/AuronForge/user-story-generator-agent#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "dotenv": "^16.3.1",
    "openai": "^4.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@jest/globals": "^29.7.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.4.1",
    "prettier": "^3.4.2",
    "standard-version": "^9.5.0"
  }
}
