            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Complete Purchase Checkout\",\n  \"description\": \"Verify that users can complete a purchase with credit card payment\",\n  \"type\": \"e2e\",\n  \"priority\": \"high\",\n  \"steps\": [\n    {\n      \"stepNumber\": 1,\n      \"action\": \"Add items to shopping cart\",\n      \"expectedResult\": \"Items appear in cart with correct pricing\"\n    },\n    {\n      \"stepNumber\": 2,\n      \"action\": \"Proceed to checkout\",\n      \"expectedResult\": \"Checkout page displays with order summary\"\n    },\n    {\n      \"stepNumber\": 3,\n      \"action\": \"Enter shipping address\",\n      \"expectedResult\": \"Address is validated and saved\"\n    },\n    {\n      \"stepNumber\": 4,\n      \"action\": \"Select shipping method\",\n      \"expectedResult\": \"Shipping cost is calculated and displayed\"\n    },\n    {\n      \"stepNumber\": 5,\n      \"action\": \"Enter credit card information\",\n      \"expectedResult\": \"Payment details are validated\"\n    },\n    {\n      \"stepNumber\": 6,\n      \"action\": \"Confirm and place order\",\n      \"expectedResult\": \"Order is processed and confirmation is displayed\"\n    }\n  ],\n  \"preconditions\": [\n    \"User is logged in\",\n    \"Items are available in inventory\",\n    \"Payment gateway is operational\"\n  ]\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/generate-user-stories",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "generate-user-stories"]
            },
            "description": "Gera user stories para fluxo completo de checkout de e-commerce"
